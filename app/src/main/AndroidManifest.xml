<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Phase 1 declares no runtime permissions on purpose. Each later phase adds
        only the permissions its feature needs (location, camera, notifications,
        foreground services) together with the user-facing consent flow.
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nexus">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Nexus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
